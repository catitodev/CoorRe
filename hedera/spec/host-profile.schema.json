{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coorre.example/hedera/host-profile.schema.json",
  "title": "CoorRe host profile",
  "description": "What a host hands to CoorRe at its input moment: the decisions under mandate, the actions they drive, who may decide, the evidence and the log. Business rules stay with the host; every value names its source.",
  "type": "object",
  "additionalProperties": false,
  "required": ["profileFormat", "hostId", "targets", "decisionPoints", "mandate", "evidence", "review", "administration", "log"],
  "properties": {
    "profileFormat": { "const": "coorre-host-profile/1" },
    "hostId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
    "hostRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "access"],
      "properties": {
        "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "access": { "const": "read-only" }
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/target" }
    },
    "decisionPoints": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/decisionPoint" }
    },
    "mandate": { "$ref": "#/$defs/mandate" },
    "evidence": { "$ref": "#/$defs/evidence" },
    "review": { "$ref": "#/$defs/review" },
    "administration": { "$ref": "#/$defs/administration" },
    "log": { "$ref": "#/$defs/log" }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref"],
      "properties": {
        "kind": { "enum": ["host-code", "host-onchain", "coorre-proposal"] },
        "ref": { "type": "string", "minLength": 1 }
      }
    },
    "evmAddress": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "selector": { "type": "string", "pattern": "^0x[0-9a-f]{8}$" },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network", "chainId", "contract", "address", "source"],
      "properties": {
        "network": { "enum": ["solo", "testnet"] },
        "chainId": { "type": "integer" },
        "contract": { "type": "string", "minLength": 1 },
        "address": { "type": ["string", "null"], "pattern": "^0x[0-9a-fA-F]{40}$" },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "typedField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$" },
        "type": { "enum": ["uint8", "uint16", "uint64", "uint256", "bytes32", "address", "string"] }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "signature", "selector"],
      "properties": {
        "verdict": { "type": "string", "pattern": "^[a-z][a-z-]*$" },
        "signature": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*\\([a-z0-9,]*\\)$" },
        "selector": { "$ref": "#/$defs/selector" }
      }
    },
    "decisionPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "trigger", "inputs", "actions", "hostActor", "modes", "deadline", "source"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "trigger": {
          "type": "object",
          "additionalProperties": false,
          "required": ["description", "state"],
          "properties": {
            "description": { "type": "string", "minLength": 1 },
            "state": { "type": "string", "minLength": 1 }
          }
        },
        "inputs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/typedField" } },
        "actions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/action" } },
        "hostActor": { "type": "string", "minLength": 1 },
        "modes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "deadline": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "call", "clock", "source"],
          "properties": {
            "kind": { "enum": ["onchain-call"] },
            "call": { "type": "string", "minLength": 1 },
            "clock": { "enum": ["block.timestamp"] },
            "source": { "$ref": "#/$defs/source" }
          }
        },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "mandate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuer", "delegates", "quorum", "validity", "autonomyLimit", "revocation"],
      "properties": {
        "issuer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["description", "keyPolicy", "source"],
          "properties": {
            "description": { "type": "string", "minLength": 1 },
            "keyPolicy": { "type": "string", "minLength": 1 },
            "source": { "$ref": "#/$defs/source" }
          }
        },
        "delegates": {
          "type": "object",
          "additionalProperties": false,
          "required": ["description", "kinds", "source"],
          "properties": {
            "description": { "type": "string", "minLength": 1 },
            "kinds": { "type": "array", "minItems": 1, "items": { "enum": ["human", "agent", "system"] } },
            "source": { "$ref": "#/$defs/source" }
          }
        },
        "quorum": {
          "type": "object",
          "additionalProperties": false,
          "required": ["default", "issuerMayRaise", "source"],
          "properties": {
            "default": { "type": "integer", "minimum": 1 },
            "issuerMayRaise": { "type": "boolean" },
            "source": { "$ref": "#/$defs/source" }
          }
        },
        "validity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fields", "clock", "default", "source"],
          "properties": {
            "fields": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } },
            "clock": { "enum": ["block.timestamp"] },
            "default": { "type": "null" },
            "source": { "$ref": "#/$defs/source" }
          }
        },
        "autonomyLimit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["appliesTo", "value", "unit", "error", "source"],
          "properties": {
            "appliesTo": { "type": "string", "minLength": 1 },
            "value": { "type": ["integer", "null"], "minimum": 0 },
            "unit": { "type": "string", "minLength": 1 },
            "error": { "const": "MandateExceeded" },
            "source": { "$ref": "#/$defs/source" }
          }
        },
        "revocation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["by", "effect", "source"],
          "properties": {
            "by": { "type": "string", "minLength": 1 },
            "effect": { "type": "string", "minLength": 1 },
            "source": { "$ref": "#/$defs/source" }
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostDocument", "hostDigest", "decisionDocument", "source"],
      "properties": {
        "hostDocument": { "type": "string", "minLength": 1 },
        "hostDigest": { "type": "string", "minLength": 1 },
        "decisionDocument": { "type": "string", "minLength": 1 },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entersWhen", "verdicts", "execution", "source"],
      "properties": {
        "entersWhen": { "type": "string", "minLength": 1 },
        "verdicts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["verdict", "executedBy", "signature", "selector"],
            "properties": {
              "verdict": { "type": "string", "pattern": "^[a-z][a-z-]*$" },
              "executedBy": { "type": "string", "minLength": 1 },
              "signature": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*\\([a-z0-9,]*\\)$" },
              "selector": { "$ref": "#/$defs/selector" }
            }
          }
        },
        "execution": { "type": "string", "minLength": 1 },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "administration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "actions", "source"],
      "properties": {
        "policy": { "enum": ["recorded", "enforced"] },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["signature", "selector"],
            "properties": {
              "signature": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*\\([a-z0-9,]*\\)$" },
              "selector": { "$ref": "#/$defs/selector" }
            }
          }
        },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "log": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ownership", "submitKey", "adminKey", "maxMessageBytes", "rotation", "source"],
      "properties": {
        "kind": { "const": "hcs-topic" },
        "ownership": { "const": "coorre" },
        "submitKey": { "type": "string", "minLength": 1 },
        "adminKey": { "type": "null" },
        "maxMessageBytes": { "type": "integer", "minimum": 1, "maximum": 1024 },
        "rotation": { "type": "string", "minLength": 1 },
        "source": { "$ref": "#/$defs/source" }
      }
    }
  }
}
