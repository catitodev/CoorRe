{
  "name": "coorre-hedera",
  "version": "0.1.0",
  "private": true,
  "description": "CoorRe on Hedera: reference fixtures and network probes",
  "license": "Apache-2.0",
  "contributors": [
    {
      "name": "Clarkson Bartalini",
      "url": "https://github.com/catitodev"
    },
    {
      "name": "Ramon Porto",
      "url": "https://github.com/ramonzitus"
    }
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "build:contracts": "HARDHAT_DISABLE_TELEMETRY=true hardhat build",
    "test:contracts": "HARDHAT_DISABLE_TELEMETRY=true hardhat test solidity",
    "check:protections": "node scripts/protection-check.mjs",
    "wata:fetch": "node scripts/wata-fetch",
    "wata:drift": "node scripts/wata-drift-check",
    "probes:compile": "node probes/compile.mjs",
    "probes:run": "node probes/run.mjs",
    "cycle:run": "node cycle/run.mjs"
  },
  "dependencies": {
    "@hiero-ledger/sdk": "2.90.1",
    "solc": "0.8.28"
  },
  "overrides": {
    "ws": "8.21.3",
    "tmp": "0.2.7"
  },
  "devDependencies": {
    "ethers": "6.16.0",
    "hardhat": "3.21.0"
  }
}
