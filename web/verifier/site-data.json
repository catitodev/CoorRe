 "rules": [
  {
   "id": "supplier-docs",
   "version": "1",
   "hash": "sha256:7320d1d698663198cb21f5f5cce3e6d0064b8300a1042ebf13fc8934fbdabd2f",
   "description": "Auto-approve a supplier payment only when every required document is present and valid on the evaluation date and the amount is within the automated actor's autonomy limit; otherwise escalate to the human approver with explicit reasons.",
   "documents": [
    "tax_certificate",
    "environmental_license"
   ],
   "labels": {
    "tax_certificate": "tax certificate",
    "environmental_license": "environmental license"
   },
   "conditions": [
    {
     "check": "tax_certificate present once and valid on the evaluation date (valid_from <= evaluation_date <= valid_until, calendar dates, inclusive)",
     "reason": "tax certificate missing | tax certificate expired | tax certificate not yet valid | tax certificate submitted more than once"
    },
    {
     "check": "environmental_license present once and valid on the evaluation date (valid_from <= evaluation_date <= valid_until, calendar dates, inclusive)",
     "reason": "environmental license missing | environmental license expired | environmental license not yet valid | environmental license submitted more than once"
    }
   ],
   "mandate": {
    "check": "amount_lamports <= autonomy_limit_lamports",
    "reason": "amount exceeds autonomy limit"
   },
   "cases": [
    "SUP-001",
    "SUP-002"
   ]
  },
  {
   "id": "agent-purchase",
   "version": "1",
   "hash": "sha256:3d77e718e5ee0b6a66448c960024fe1dadff3950364eed67e2401d23eecc91b2",
   "description": "Auto-approve the payment of a purchase prepared by an AI agent only when the purchase request, the supplier's quote and the supplier's registration agree, the registration is approved and current, the quote is current, the amount equals the quote and fits the budget cap, and the amount is within the automated actor's autonomy limit; otherwise escalate to the human approver with one reason per failed condition, in the order listed.",
   "documents": [
    "purchase_request",
    "supplier_quote",
    "supplier_registration"
   ],
   "labels": {
    "purchase_request": "purchase request",
    "supplier_quote": "supplier quote",
    "supplier_registration": "supplier registration"
   },
   "conditions": [
    {
     "check": "each required document kind is submitted exactly once",
     "reason": "<label> missing | <label> submitted more than once"
    },
    {
     "check": "purchase_request.request_number == supplier_quote.request_number",
     "reason": "request number differs between request and quote"
    },
    {
     "check": "purchase_request.item == supplier_quote.item",
     "reason": "item differs between request and quote"
    },
    {
     "check": "supplier_quote.supplier == supplier_registration.supplier",
     "reason": "supplier differs between quote and registration"
    },
    {
     "check": "supplier_registration.status == \"approved\"",
     "reason": "supplier registration not approved"
    },
    {
     "check": "supplier_registration.valid_until >= evaluation_date",
     "reason": "supplier registration expired"
    },
    {
     "check": "supplier_quote.valid_until >= evaluation_date",
     "reason": "supplier quote expired"
    },
    {
     "check": "amount_lamports == supplier_quote.amount_lamports",
     "reason": "amount differs from the quote"
    },
    {
     "check": "amount_lamports <= purchase_request.budget_cap_lamports",
     "reason": "amount exceeds the budget cap"
    }
   ],
   "mandate": {
    "check": "amount_lamports <= autonomy_limit_lamports",
    "reason": "amount exceeds autonomy limit"
   },
   "cases": [
    "AGT-001",
    "AGT-002"
   ]
  },
  {
   "id": "ecosystem-services-payment",
   "version": "1",
   "hash": "sha256:eb9e053a54cf94256949e7bb134390e68efb86fa4be4434f1b0c24d34d4307c9",
   "description": "Auto-approve a payment for ecosystem services only when the contract and the monitoring report refer to the same contract, the contract is valid on the evaluation date, the monitoring was observed within the contract validity and not after the evaluation date, the verified area is at least the committed area, and the amount is within the automated actor's autonomy limit; otherwise escalate to the human approver with one reason per failed condition, in the order listed.",
   "documents": [
    "pes_contract",
    "monitoring_report"
   ],
   "labels": {
    "pes_contract": "ecosystem services contract",
    "monitoring_report": "monitoring report"
   },
   "conditions": [
    {
     "check": "each required document kind is submitted exactly once",
     "reason": "<label> missing | <label> submitted more than once"
    },
    {
     "check": "pes_contract.contract_number == monitoring_report.contract_number",
     "reason": "contract number differs between contract and monitoring report"
    },
    {
     "check": "pes_contract.valid_from <= evaluation_date <= pes_contract.valid_until",
     "reason": "ecosystem services contract not yet valid | ecosystem services contract expired"
    },
    {
     "check": "pes_contract.valid_from <= monitoring_report.observed_on <= pes_contract.valid_until and monitoring_report.observed_on <= evaluation_date",
     "reason": "monitoring observed outside the contract validity | monitoring observed after the evaluation date"
    },
    {
     "check": "monitoring_report.verified_area_m2 >= pes_contract.committed_area_m2",
     "reason": "verified area below committed area"
    }
   ],
   "mandate": {
    "check": "amount_lamports <= autonomy_limit_lamports",
    "reason": "amount exceeds autonomy limit"
   },
   "cases": [
    "PES-001",
    "PES-002"
   ]
  },
  {
   "id": "milestone-payment",
   "version": "1",
   "hash": "sha256:bb7edb9e6d965c6c508d1f3abcb56000811e7dbd4fe558145dddc874bc37ed85",
   "description": "Auto-approve the installment of a funded project only when the funding agreement, the milestone report and the accountability report refer to the same agreement, the report covers the agreed milestone and was delivered within its window, previous installments are accounted for with no open findings, the amount fits the milestone amount, and the amount is within the automated actor's autonomy limit; otherwise escalate to the human approver with one reason per failed condition, in the order listed.",
   "documents": [
    "funding_agreement",
    "milestone_report",
    "accountability_report"
   ],
   "labels": {
    "funding_agreement": "funding agreement",
    "milestone_report": "milestone report",
    "accountability_report": "accountability report"
   },
   "conditions": [
    {
     "check": "each required document kind is submitted exactly once",
     "reason": "<label> missing | <label> submitted more than once"
    },
    {
     "check": "funding_agreement.agreement_number == milestone_report.agreement_number == accountability_report.agreement_number",
     "reason": "agreement number differs between documents"
    },
    {
     "check": "funding_agreement.milestone_id == milestone_report.milestone_id",
     "reason": "milestone differs between agreement and report"
    },
    {
     "check": "funding_agreement.window_from <= milestone_report.delivered_on <= funding_agreement.window_until",
     "reason": "milestone delivered outside the agreed window"
    },
    {
     "check": "accountability_report.previous_installments_accounted == \"true\"",
     "reason": "previous installments not accounted for"
    },
    {
     "check": "accountability_report.open_findings == \"0\"",
     "reason": "open findings in the accountability report"
    },
    {
     "check": "amount_lamports <= funding_agreement.milestone_amount_lamports",
     "reason": "amount exceeds the milestone amount"
    }
   ],
   "mandate": {
    "check": "amount_lamports <= autonomy_limit_lamports",
    "reason": "amount exceeds autonomy limit"
   },
   "cases": [
    "MIL-001",
    "MIL-002"
   ]
  },
  {
   "id": "service-delivery",
   "version": "1",
   "hash": "sha256:c8ef062c4eb22745086f9ff84b143c5549b06aef0079aa3e52327a0a9928e21c",
   "description": "Auto-approve the payment of a service contract only when the contract, the acceptance record and the invoice refer to the same contract, the provider on the invoice is the contracted one, the deliverable was accepted within the contract validity, the invoice was issued on or after the acceptance, the amount equals the invoice, the invoice fits the price cap, and the amount is within the automated actor's autonomy limit; otherwise escalate to the human approver with one reason per failed condition, in the order listed.",
   "documents": [
    "service_contract",
    "acceptance_record",
    "invoice"
   ],
   "labels": {
    "service_contract": "service contract",
    "acceptance_record": "acceptance record",
    "invoice": "invoice"
   },
   "conditions": [
    {
     "check": "each required document kind is submitted exactly once",
     "reason": "<label> missing | <label> submitted more than once"
    },
    {
     "check": "service_contract.contract_number == acceptance_record.contract_number == invoice.contract_number",
     "reason": "contract number differs between documents"
    },
    {
     "check": "service_contract.provider == invoice.provider",
     "reason": "provider differs between contract and invoice"
    },
    {
     "check": "service_contract.valid_from <= acceptance_record.accepted_on <= service_contract.valid_until",
     "reason": "acceptance outside the contract validity"
    },
    {
     "check": "invoice.issued_on >= acceptance_record.accepted_on",
     "reason": "invoice issued before acceptance"
    },
    {
     "check": "amount_lamports == invoice.amount_lamports",
     "reason": "amount differs from the invoice"
    },
    {
     "check": "invoice.amount_lamports <= service_contract.price_cap_lamports",
     "reason": "invoice amount exceeds the price cap"
    }
   ],
   "mandate": {
    "check": "amount_lamports <= autonomy_limit_lamports",
    "reason": "amount exceeds autonomy limit"
   },
   "cases": [
    "SRV-001",
    "SRV-002"
   ]
  }
 ],
